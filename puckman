usage="
puckman (v3.1)
=======
Installs software from github releases


Usage:
    puckman <action> [package name]

Actions:
    ls
            list available packages

    install <package name>
            duh!

    uninstall <package name>   (aliases: remove, delete)
            remove installs recorded since v3.1 (see PUCKMAN_STATE)

    search <search term>
            searches repositories in github. It presents a limited set of the
            most popular results and offers the possibility to install

    <package name>
            (no action specified) search and install if unique
    update
            updates puckman downloading the latest code from Github

    requirements   (aliases: deps, install-deps)
            installs required + recommended dependencies after confirmation

Dependencies install command:
    sudo $(apt_install_requirements_cmd)

"

WGET="wget -T 5 --tries=1 --backups=2"
GITHUB_TOKEN=""
UPDATE_LINK="https://raw.githubusercontent.com/pandiloko/puckman/master/puckman"

case $# in
    0) 
        echo "$usage" && exit 0
        ;;
    1) 
        case "$1" in
            update|upgrade)
                action=update
                ;;
            requirements|deps|install-deps)
                action=requirements
                ;;
            h|-h|--help|help)
                echo "$usage" && exit 0
                ;;
            ls|list)
                action=list
                ;;
            *)
                action=install
                package="$1"
                ;;
        esac
        ;;
    2) 
        action="$1"
        package="$2"
        ;;
    *) 
        echo $usage && exit 1
        ;;
esac

get_env_vars
get_github_token

readconfig

if [ "$action" != "requirements" ]; then
    check_environment
fi


case $action in
    requirements)
        user_is_root || { echo "User must be root to $action" && exit 1 ;}
        TTY=$(tty)
        install_requirements
        ;;
    update)
        user_is_root || { echo "User must be root to $action puckman" && exit 1 ;}
        update
        ;;
    remove|uninstall|delete)
        user_is_root || { echo "User must be root to $action $package" && exit 1 ;}
        showconfig
        uninstall
        ;;
    list)
        list
        exit $?
        ;;
    install)
        user_is_root || { echo "User must be root to $action $package" && exit 1 ;}
        showconfig
        install
        ;;
    search|query|find)
        if search;then
            install
        fi
        ;;
    *)
        echo "I don't know how to $action $package"
        exit 1
        ;;
esac

exit 0

