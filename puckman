#!/bin/bash

get_github_token(){
    local locations=(
        "$HOME/Sync/$USER/.githubtoken"
        "$HOME/.githubtoken"
        "/etc/githubtoken"
    )
    for l in "${locations[@]}"; do
        if [ -f "$l" ];then
            GITHUB_TOKEN=("--header" "Authorization: token $(cat "$l")")
            export GITHUB_TOKEN
            break
        fi
    done
}

get_env_vars(){
    #try default locations
    local locations=(
        "$HOME/Sync/puckman"
        "$HOME/.config/puckman"
        "/etc/puckman"
    )
    PUCKMAN_LIST=""
    PUCKMAN_DESCRIPTIONS=""
    for l in "${locations[@]}"; do
        if [ -d "$l" ];then
            PUCKMAN_LIST="${l}/packages.txt"
            PUCKMAN_DESCRIPTIONS="${l}/descriptions.txt"
            PUCKMAN_CONFIG="${l}/puckman.conf"
            break
        fi
    done

    [ -z "$PUCKMAN_CACHE" ] && PUCKMAN_CACHE=/var/cache/tmp/puckman
    export PUCKMAN_CACHE
    [ -z "$PUCKMAN_PKG" ] && PUCKMAN_PKG=/var/cache/puckman
    export PUCKMAN_PKG
    [ -z "$PUCKMAN_CONFIG" ] && PUCKMAN_CONFIG="/etc/puckman/puckman.conf"
    export PUCKMAN_CONFIG
    [ -z "$PUCKMAN_DESCRIPTIONS" ] && PUCKMAN_DESCRIPTIONS="/etc/puckman/descriptions.txt"
    export PUCKMAN_DESCRIPTIONS
    [ -z "$PUCKMAN_LIST" ] && PUCKMAN_LIST="/etc/puckman/packages.txt"
    export PUCKMAN_LIST
    [ -z "$PUCKMAN_STATE" ] && PUCKMAN_STATE=/var/lib/puckman
    export PUCKMAN_STATE
}

# Compute edit distance between two strings using a pure bash fallback.
# Used when python3-pylev is unavailable.
levenshtein() {
    if [ "$#" -ne "2" ]; then
        echo "Usage: $0 word1 word2" >&2
    elif [ "${#1}" -lt "${#2}" ]; then
        levenshtein "$2" "$1"
    else
        local str1len=$((${#1}))
        local str2len=$((${#2}))
        local d i j
        for i in $(seq 0 $(((str1len+1)*(str2len+1)))); do
            d[i]=0
        done
        for i in $(seq 0 $((str1len))); do
            d[$((i+0*str1len))]=$i
        done
        for j in $(seq 0 $((str2len))); do
            d[$((0+j*(str1len+1)))]=$j
        done

        for j in $(seq 1 $((str2len))); do
            for i in $(seq 1 $((str1len))); do
                [ "${1:i-1:1}" = "${2:j-1:1}" ] && local cost=0 || local cost=1
                local del=$((d[(i-1)+str1len*j]+1))
                local ins=$((d[i+str1len*(j-1)]+1))
                local alt=$((d[(i-1)+str1len*(j-1)]+cost))
                d[i+str1len*j]=$(echo -e "$del\n$ins\n$alt" | sort -n | head -1)
            done
        done
        echo ${d[str1len+str1len*(str2len)]}
    fi
# while read str1; do
#         while read str2; do
#                 lev=$(levenshtein "$str1" "$str2");
#                 printf '%s / %s : %s\n' "$str1" "$str2" "$lev"
#         done < "$2"
# done < "$1"
}

levenshtein_pylev(){
    python3 -c 'import pylev, sys; print(pylev.levenshtein(sys.argv[1], sys.argv[2]))' "$1" "$2"
}

# Pick the best release artifact by minimum Levenshtein distance.
# Sets global download_link as a side effect.
calculate_levenshtein(){
    local best_value
    local best_link
    local current_value
    echo "Calculating best levenshtein value..."
    if python3 -c "import pylev" 2> /dev/null;then
	echo "Using python3 pylev implementation"
	LEVENSHTEIN_CMD=levenshtein_pylev
    else
        echo "Consider installing python3-pylev for a faster Levenshtein algorithm implementation"
	LEVENSHTEIN_CMD=levenshtein
    fi
    while read -r line;do
        current_value=$($LEVENSHTEIN_CMD "$(basename "$line")" "$1")
        [[ ! -v best_value ]] && best_value=$current_value
        [[ ! -v best_link ]] && best_link=$line
        if [ $current_value -eq 0 ];then
            download_link=$line
            return 0
        elif [ $current_value -lt $best_value ];then
            best_link=$line
            best_value=$current_value
        fi
    done < <( github_release "$link" )
    download_link=$best_link
    echo "best value: $best_value"
    echo "best link: $best_link"
}




# Print numbered menu; on success set var named by $4 to first awk field of chosen line.
# Render a numbered selection menu and export the chosen first column.
# Writes selected value into the destination variable name passed by caller.
pick_numbered_line() {
    local heading="$1" prompt="$2"
    local -n _pick_lines="$3"
    local _pick_dest="$4"
    [ "${#_pick_lines[@]}" -lt 1 ] && return 1
    echo "----------------------"
    echo "$heading"
    echo
    local idx
    for idx in "${!_pick_lines[@]}"; do
        echo "$((idx + 1)). ${_pick_lines[idx]}"
    done
    echo
    echo "$prompt"
    echo "Enter a number or just press <return> to skip"
    read -rp "Choose a number: " pick_index
    if [[ "$pick_index" =~ ^[0-9]+$ ]] && [ "$pick_index" -gt 0 ] && [ "$pick_index" -le "${#_pick_lines[@]}" ]; then
        printf -v "$_pick_dest" '%s' "$(echo "${_pick_lines[$((pick_index - 1))]}" | awk '{print $1}')"
        export "$_pick_dest"
        return 0
    fi
    return 1
}

search (){
    #expects search term in global variable $package and modifies it to reflect the result
    local search_results

    readarray -t search_results < <(github_search "$package")
    pick_numbered_line "Search results" "Do you want to install any of them?" search_results package
}

github_search(){
    # query github with query string and return projects sorted by stars
    local query="$1"
    local enc
    enc=$(python3 -c 'import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1], safe=""))' "$query")
    $WGET --header "Accept: application/vnd.github+json" "${GITHUB_TOKEN[@]}" \
        "https://api.github.com/search/repositories?q=${enc}+in:name,description" -qO - \
    | jq  -r '.items | sort_by(.stargazers_count) |reverse | .[]| "\(.full_name)\t\(.stargazers_count)\t\(.description)"'  | head -n20 | column -ts $'\t'
}

github_release_picker(){
    local search_results

    readarray -t search_results < <(github_release "$1")
    pick_numbered_line "Release artifacts available" "Pick the appropriate download for your system" search_results download_link
}

github_release(){
    if [ -n "$1" ];then
        $WGET --header "Accept: application/vnd.github+json" "${GITHUB_TOKEN[@]}" "https://api.github.com/repos/$1/releases/latest" -qO - | jq -r '.assets[].browser_download_url'        
    else
        echo "Please provide github  <user/project> string e.g. borgbackup/borg"; 
        return 1
    fi
    return 0
}

trim() {
    local var="$*"
    # remove leading whitespace characters
    var="${var#"${var%%[![:space:]]*}"}"
    # remove trailing whitespace characters
    var="${var%"${var##*[![:space:]]}"}"
    printf '%s' "$var"
}

url_size(){
    local output
    output=$($WGET --spider --server-response -q "$1" 2>&1 |grep -i content-length | awk '{$1=""}1'|tail -n1)
    trim "$output"
}

url_timestamp(){
    local output
    output=$($WGET --spider --server-response -q "$1" 2>&1 |grep -i last-modified | awk '{$1=""}1'|tail -n1)
    output=$(date -d "$output" +%s)
    trim "$output"
}

# Inspect an archive and report candidate payload count and install target.
# Returns "count#original_name#final_name" after filtering non-binary artifacts.
archive_count(){
    #output count of files in archive 
    # if count=1 also orig name and final name
    # files to ignore
    release_artifacts_to_ignore='.*svg\|.*desktop\|.*\.1\|.*txt$\|LICENSE.*\|.*md$\|README$\|NEWS$\|CHANGELOG.*\|\/$'
    local count=0
    local temp
    temp=$(mktemp)
    trap 'rm -f "$temp"' RETURN
    local original_name="-"
    local final_name="-"
    case $# in
        1) 
            local file="$1"
            [ ! -f "$PUCKMAN_PKG/$file" ] && echo 0 && return 1
            ;;
        *) 
            echo 0 && return 1
            ;;
    esac
    case $file in
        *.zip)
            unzip -Z1 "$PUCKMAN_PKG/$file" | grep -iv "$release_artifacts_to_ignore" > "$temp"
            count=$(wc -l < "$temp" | tr -d ' ')
            ;;
        *.tar.gz|*.tgz|*.tbz|*.tar.xz|*.txz|*.tar.bz2|*.tbz2)
            tar -tf "$PUCKMAN_PKG/$file" | grep -iv "$release_artifacts_to_ignore" > "$temp"
            count=$(wc -l < "$temp" | tr -d ' ')
            ;;
        *.bz2)
            count=1
            original_name="${file%.bz2}"
            if [[ "$original_name" =~ ^([a-z]+) ]]; then
                final_name="/usr/local/bin/${BASH_REMATCH[1]}"
            else
                final_name="/usr/local/bin/${original_name##*/}"
            fi
            echo "${count}#${original_name}#${final_name}"
            return 0
            ;;
    esac

    #OUTPUT:
    # count#orig#final
    if [ $count -eq 1 ];then
        original_name=$(cat "$temp")
        if [[ "$original_name" =~ ^([a-z]+) ]]; then
            final_name="/usr/local/bin/${BASH_REMATCH[1]}"
        else
            final_name="/usr/local/bin/${original_name##*/}"
        fi
    fi
    echo "${count}#${original_name}#${final_name}"
    return 0
}

_gd_emit_unique_and_exit() {
    local rt="$1" ct="$2"
    cat "$ct"
    trap - EXIT
    rm -f "$rt" "$ct"
    return 0
}

_try_dl_unique() {
    local rt="$1" ct="$2" n
    n=$(wc -l < "$ct" | tr -d ' ')
    [ "$n" -eq 1 ] || return 1
    _gd_emit_unique_and_exit "$rt" "$ct"
}

# When several .deb assets match the CPU (e.g. gnu vs musl triplet), prefer glibc (Debian default).
_try_dl_unique_deb_abi() {
    local rt="$1" ct="$2" n
    n=$(wc -l < "$ct" | tr -d ' ')
    [ "$n" -eq 1 ] && _gd_emit_unique_and_exit "$rt" "$ct" && return 0
    [ "$n" -eq 0 ] && return 1

    # 1) Prefer explicit glibc triplet builds.
    grep -F 'unknown-linux-gnu' "$ct" > "${ct}._abi" 2>/dev/null || : > "${ct}._abi"
    n=$(wc -l < "${ct}._abi" | tr -d ' ')
    if [ "$n" -eq 1 ]; then
        rm -f "$ct"
        mv "${ct}._abi" "$ct"
        _gd_emit_unique_and_exit "$rt" "$ct"
        return 0
    fi
    rm -f "${ct}._abi"

    # 2) Prefer non-musl variants when both are present.
    grep -iv 'musl' "$ct" > "${ct}._abi" 2>/dev/null || : > "${ct}._abi"
    n=$(wc -l < "${ct}._abi" | tr -d ' ')
    if [ "$n" -eq 1 ]; then
        rm -f "$ct"
        mv "${ct}._abi" "$ct"
        _gd_emit_unique_and_exit "$rt" "$ct"
        return 0
    fi
    if [ "$n" -gt 1 ]; then
        rm -f "$ct"
        mv "${ct}._abi" "$ct"
    else
        rm -f "${ct}._abi"
    fi

    # 3) Prefer the plain .deb over *_xz.deb when both exist.
    grep -iv '_xz\.deb$' "$ct" > "${ct}._abi" 2>/dev/null || : > "${ct}._abi"
    n=$(wc -l < "${ct}._abi" | tr -d ' ')
    if [ "$n" -eq 1 ]; then
        rm -f "$ct"
        mv "${ct}._abi" "$ct"
        _gd_emit_unique_and_exit "$rt" "$ct"
        return 0
    fi
    rm -f "${ct}._abi"

    # 4) If only musl remains uniquely identifiable, accept it.
    grep -F 'unknown-linux-musl' "$ct" > "${ct}._abi" 2>/dev/null || : > "${ct}._abi"
    n=$(wc -l < "${ct}._abi" | tr -d ' ')
    if [ "$n" -eq 1 ]; then
        rm -f "$ct"
        mv "${ct}._abi" "$ct"
        _gd_emit_unique_and_exit "$rt" "$ct"
        return 0
    fi
    rm -f "${ct}._abi"
    return 1
}

# Release lines to drop when matching generic/binary assets (checksums, other OS, etc.).
_gd_exclude_foreign_and_meta='\.(asc|sig|gpg|sha256|sha512|sha1|md5|minisig)$|[-.]sha[0-9]+|checksum|SUMS$|sbom|\.pem$|\.crt$|\.msix$|\.msi$|\.exe$|\.dmg$|\.pkg$|\.deb$|\.rpm$|windows|win32|win64|w64|macos|darwin|apple|osx|android'

# Heuristically choose a release artifact URL for the current system.
# Uses package-manager hints, architecture filters, and optional regex fallback.
get_download_link(){
    # Heuristic choice of a release asset URL for this machine (ordered tries).

    local arch_uname arch_deb arch_rpm arch_grep
    arch_uname=$(uname -m)
    arch_deb=""
    arch_rpm=""
    arch_grep=""

    if command -v dpkg >/dev/null 2>&1; then
        arch_deb=$(dpkg --print-architecture 2>/dev/null || true)
    fi

    case $arch_uname in
        i386|i686)
            arch_rpm="i386"
            arch_grep='i386|i686|386'
            ;;
        x86_64)
            arch_rpm="x86_64"
            arch_grep='x86_64|amd64|x64'
            ;;
        aarch64|arm64)
            arch_rpm="aarch64"
            arch_grep='aarch64|arm64|armv8'
            ;;
        armv7l|armv6l)
            arch_rpm="armv7hl"
            arch_grep='armv7|armhf|armv6|armel'
            ;;
        arm*)
            arch_rpm="arm"
            arch_grep='arm'
            ;;
        riscv64)
            arch_rpm="riscv64"
            arch_grep='riscv64|riscv'
            ;;
        *)
            arch_grep="$arch_uname"
            ;;
    esac

    local release_temp candidates_temp pkg
    release_temp=$(mktemp)
    candidates_temp=$(mktemp)
    trap 'rm -f "$release_temp" "$candidates_temp"' EXIT
    github_release "$link" > "$release_temp"

    # Prefer RPM tooling when present (matches older puckman behavior on mixed setups).
    pkg=""
    if type dnf &>/dev/null || type yum &>/dev/null; then
        pkg=rpm
    elif type apt-get &>/dev/null || type apt &>/dev/null; then
        pkg=deb
    fi

    # .deb: Debian *_amd64.deb naming, then dpkg arch substring, then triplet-style names
    # (Rust/cross builds often use x86_64/aarch64 in the filename instead of amd64/arm64).
    if [ "$pkg" = deb ]; then
        local deb_triplet_grep=""
        case $arch_deb in
            amd64) deb_triplet_grep='x86_64|amd64' ;;
            arm64) deb_triplet_grep='aarch64|arm64' ;;
            i386) deb_triplet_grep='i386|i686|386' ;;
            armhf) deb_triplet_grep='armhf|armv7' ;;
            armel) deb_triplet_grep='armel' ;;
            riscv64) deb_triplet_grep='riscv64|riscv' ;;
            "") ;;
            *) deb_triplet_grep="$arch_deb" ;;
        esac

        if [ -n "$arch_deb" ]; then
            grep -E '\.deb$' "$release_temp" | grep -E "_${arch_deb}\\.deb\$" > "$candidates_temp"
            _try_dl_unique_deb_abi "$release_temp" "$candidates_temp" && return 0
            grep -E '\.deb$' "$release_temp" | grep -F "$arch_deb" > "$candidates_temp"
            _try_dl_unique_deb_abi "$release_temp" "$candidates_temp" && return 0
        fi
        if [ -n "$deb_triplet_grep" ]; then
            grep -E '\.deb$' "$release_temp" | grep -Ei "$deb_triplet_grep" > "$candidates_temp"
            _try_dl_unique_deb_abi "$release_temp" "$candidates_temp" && return 0
        fi
        if [ -n "$arch_grep" ]; then
            grep -E '\.deb$' "$release_temp" | grep -Ei "$arch_grep" > "$candidates_temp"
            _try_dl_unique_deb_abi "$release_temp" "$candidates_temp" && return 0
        fi
        grep -E '\.deb$' "$release_temp" > "$candidates_temp"
        _try_dl_unique "$release_temp" "$candidates_temp" && return 0
    fi

    # .rpm: match filename containing RPM arch, else any single .rpm.
    if [ "$pkg" = rpm ]; then
        if [ -n "$arch_rpm" ]; then
            grep -E '\.rpm$' "$release_temp" | grep -Fi "$arch_rpm" > "$candidates_temp"
            _try_dl_unique "$release_temp" "$candidates_temp" && return 0
        fi
        grep -E '\.rpm$' "$release_temp" > "$candidates_temp"
        _try_dl_unique "$release_temp" "$candidates_temp" && return 0
    fi

    # Portable archives / binaries: require arch hint in the URL/filename when possible.
    if [ -n "$arch_grep" ]; then
        grep -ivE "$_gd_exclude_foreign_and_meta" "$release_temp" | grep -Ei 'linux|gnu|unknown-linux' | grep -Ei "$arch_grep" > "$candidates_temp"
        _try_dl_unique "$release_temp" "$candidates_temp" && return 0
        grep -ivE "$_gd_exclude_foreign_and_meta" "$release_temp" | grep -Ei "$arch_grep" > "$candidates_temp"
        _try_dl_unique "$release_temp" "$candidates_temp" && return 0
    fi

    # x86_64: allow "generic" Linux build with no arch token in the name.
    if [ "$arch_uname" = "x86_64" ]; then
        grep -ivE "$_gd_exclude_foreign_and_meta|arm|aarch|riscv|i386|i686|386" "$release_temp" | grep -ivE 'SHA|source|src\.|\.src\.' > "$candidates_temp"
        _try_dl_unique "$release_temp" "$candidates_temp" && return 0
    fi

    # Single remaining asset after stripping obvious non-installers.
    grep -ivE "$_gd_exclude_foreign_and_meta" "$release_temp" > "$candidates_temp"
    _try_dl_unique "$release_temp" "$candidates_temp" && return 0

    # Exact basename match (repo name as filename).
    grep -F "$(basename "$link")" "$release_temp" | grep -ivE '\.(asc|sig|gpg|sha256|sha512|sha1)$' > "$candidates_temp"
    _try_dl_unique "$release_temp" "$candidates_temp" && return 0

    # packages.txt regex (if set).
    local out=""
    if [ -n "$regex" ]; then
        out=$(grep -m 1 -E "$regex" "$release_temp" | tr -d '"')
    fi
    trap - EXIT
    rm -f "$release_temp" "$candidates_temp"
    [ -n "$out" ] && printf '%s\n' "$out"
}

install_manifest_path(){
    printf '%s/installed/%s.json' "$PUCKMAN_STATE" "$(printf '%s' "$1" | tr '/' '_')"
}

install_timestamp(){
    date -Iseconds 2>/dev/null || date
}

write_manifest_deb(){
    local link="$1" deb_pkg="$2" artifact="$3"
    mkdir -p "$PUCKMAN_STATE/installed"
    jq -n \
        --arg repo "$link" \
        --arg kind deb \
        --arg deb "$deb_pkg" \
        --arg art "$artifact" \
        --arg at "$(install_timestamp)" \
        '{repo: $repo, kind: $kind, deb_package: $deb, artifact: $art, installed_at: $at}' \
        > "$(install_manifest_path "$link")"
}

write_manifest_file(){
    local link="$1" path="$2" artifact="$3"
    mkdir -p "$PUCKMAN_STATE/installed"
    jq -n \
        --arg repo "$link" \
        --arg kind file \
        --arg p "$path" \
        --arg art "$artifact" \
        --arg at "$(install_timestamp)" \
        '{repo: $repo, kind: $kind, files: [$p], artifact: $art, installed_at: $at}' \
        > "$(install_manifest_path "$link")"
}

write_manifest_pip(){
    local name="$1" pip_cmd="$2"
    mkdir -p "$PUCKMAN_STATE/installed"
    jq -n \
        --arg repo "$name" \
        --arg kind pip \
        --arg cmd "$pip_cmd" \
        --arg pkg "$name" \
        --arg at "$(install_timestamp)" \
        '{repo: $repo, kind: $kind, pip_command: $cmd, pip_package: $pkg, installed_at: $at}' \
        > "$(install_manifest_path "$name")"
}

remove_tracked_files(){
    local mf="$1"
    local paths
    mapfile -t paths < <(jq -r '.files[]? | select(. != null and . != "")' "$mf" 2>/dev/null)
    local p
    for p in "${paths[@]}"; do
        case "$p" in
            /usr/local/bin/*)
                rm -f -- "$p"
                ;;
            *)
                echo "Refusing to remove path outside /usr/local/bin: $p" >&2
                return 1
                ;;
        esac
    done
}

# Extract one binary from zip or tar into PUCKMAN_CACHE and copy to final_name (count==1 path).
# Extract a single-file archive into cache and install it to the final path.
# Also writes file install manifest on success.
install_single_binary_archive() {
    local link="$1" download_file="$2" original_name="$3" final_name="$4" kind="$5"
    echo "It is an archive with only one file (after discarding irrelevant artifacts). Hopefully a binary alone. Trying to install to /usr/local/bin"
    echo "Candidate file is: $original_name"
    cd "$PUCKMAN_CACHE" || return 1
    case "$kind" in
        zip)
            unzip -o "$PUCKMAN_PKG/$download_file" || { cd - >/dev/null || true; return 1; }
            ;;
        tar)
            tar -xf "$PUCKMAN_PKG/$download_file" || { cd - >/dev/null || true; return 1; }
            ;;
        *)
            cd - >/dev/null || true
            return 1
            ;;
    esac
    if cp "$PUCKMAN_CACHE/$original_name" "$final_name"; then
        echo "Installed to $final_name"
        write_manifest_file "$link" "$final_name" "$download_file"
    else
        cd - >/dev/null || true
        return 1
    fi
    cd - >/dev/null || true
    return 0
}

packages_txt_match_count() {
    local term="$1"
    local m
    m=$(grep -c -F -- "$term" "$PUCKMAN_LIST" 2>/dev/null || true)
    [ -z "$m" ] && m=0
    printf '%s' "$m"
}

# Resolve user input into an owner/repo link from packages.txt.
# Accepts direct owner/repo input and rejects ambiguous matches.
resolve_package_to_link(){
    local term="$1"
    local matches
    matches=$(packages_txt_match_count "$term")
    if [ "$matches" -eq 0 ]; then
        if [[ "$term" == */* ]]; then
            printf '%s\n' "$term"
            return 0
        fi
        echo "No packages.txt match for '$term' and not owner/repo (use user/project)." >&2
        return 1
    elif [ "$matches" -gt 1 ]; then
        echo "Ambiguous match — refine your term:" >&2
        grep -F -- "$term" "$PUCKMAN_LIST" >&2
        return 1
    else
        grep -F -- "$term" "$PUCKMAN_LIST" | head -n1 | cut -d'#' -f1
    fi
}

# Remove a previously installed package using recorded install manifests.
# Supports deb, file, and pip install kinds.
uninstall(){
    local link mf kind
    link=$(resolve_package_to_link "$package") || return 1
    mf=$(install_manifest_path "$link")
    if [ ! -f "$mf" ]; then
        echo "No install manifest at $mf (nothing recorded for '$link')." >&2
        return 1
    fi
    kind=$(jq -r .kind "$mf")
    case "$kind" in
        deb)
            local deb_pkg
            deb_pkg=$(jq -r .deb_package "$mf")
            DEBIAN_FRONTEND=noninteractive apt-get purge -y "$deb_pkg" || return 1
            ;;
        file)
            local fc
            fc=$(jq '.files | length' "$mf")
            if [ "${fc:-0}" -lt 1 ]; then
                echo "Invalid file manifest (no paths)" >&2
                return 1
            fi
            remove_tracked_files "$mf" || return 1
            ;;
        pip)
            local pip_cmd pip_pkg
            pip_cmd=$(jq -r .pip_command "$mf")
            pip_pkg=$(jq -r .pip_package "$mf")
            sudo $pip_cmd uninstall -y "$pip_pkg" || return 1
            ;;
        *)
            echo "Unknown manifest kind: $kind" >&2
            return 1
            ;;
    esac
    rm -f -- "$mf"
    echo "Uninstalled $link (manifest removed)."
}

# Main install workflow: resolve package, pick artifact, install, and record manifest.
# May modify package list entries and perform network/package-manager operations.
install(){
    local link=""
    local regex=""
    local download_link=""
    local download_file=""
    local original_name=""
    local final_name=""
    local count=0    
    
    local matches
    matches=$(packages_txt_match_count "$package")
    if [ "$matches" -eq 0 ];then
        echo
        echo "No matches for [ $package ]."
        echo
        echo "Searching for candidates:"
        
        if ! search "$package" ;then 
            return 1
        else
            link="$package"
        fi
    elif [ $matches -gt 1 ];then
        echo
        echo "More than one match found for [ $package ]. Refine your search term."
        echo "Results:"
        #TODO select
        echo
        grep -F -- "$package" "$PUCKMAN_LIST"
        echo
        return 1
    elif [ $matches -eq 1 ];then
        # Read regex and link and check if not empty
        IFS="#" read -r link regex editors_pick < <(grep -F -- "$package" "$PUCKMAN_LIST")

        if [[ -z "$regex" ]]; then
            echo "No regex defined: $link"
        fi
    fi
    # At this point we should have at least a desired project
    # Ensure owner/repo (link) is recorded — not the user's fuzzy search term
    if ! awk -F'#' -v l="$link" 'BEGIN{f=0} $1==l{f=1} END{exit f?0:1}' "$PUCKMAN_LIST" 2>/dev/null;then
        echo "Adding package $link to list in $PUCKMAN_LIST"
        printf '%s\n' "$link" >> "$PUCKMAN_LIST"
    fi
    #If regex is a pip command we don't need to try github at all
    if [[ "$regex" =~ pip|pip2|pip3 ]];then
        #regex should be the appropriate command and link the package name
        echo "installing $link using pip"
        echo "COMMAND: $regex install --upgrade $link"
        if sudo $regex install --upgrade "$link"; then
            write_manifest_pip "$link" "$regex"
            return 0
        fi
        return 1
    fi
    
    #If we have recorded latest pick, use that to find out the best candidate
    if [ -n "$editors_pick" ];then
        # first try an easy win
        download_link=""
        while IFS= read -r u; do
            [[ "$u" == */"$editors_pick" ]] || continue
            download_link=$u
            break
        done < <(github_release "$link")
        # if that doesn't we try the more expensive method
        if [[ -z "$download_link" ]]; then    
            calculate_levenshtein "$editors_pick"
        fi
    fi
    if [[ -z "$download_link" ]]; then
        download_link=$(get_download_link)
    fi
    if [[ -z "$download_link" ]]; then
        echo "Heuristics did not find a unique release asset for this system; pick one manually."
        github_release_picker "$link"
        local pick_line="${link}##$(basename "$download_link")"
        if [ "$(awk -F'#' -v l="$link" '$1==l{c++} END{print c+0}' "$PUCKMAN_LIST")" -eq 1 ];then
            # if the user handpicked a link, we save that as editors_pick to apply levenshtein on future calls
            local t
            t=$(mktemp)
            awk -F'#' -v l="$link" -v new="$pick_line" '
                $1 == l { if (!done) { print new; done = 1 }; next }
                { print }
            ' "$PUCKMAN_LIST" > "$t"
            mv "$t" "$PUCKMAN_LIST"
        else
            printf '%s\n' "$pick_line" >> "$PUCKMAN_LIST"
        fi
    fi
    
    download_file=$(basename "$download_link")
    if [[ -z "$download_file" ]]; then
        echo "download link is wrong or bad format. Download link is: $download_link" && return 1
    fi

    local download=0
    if [ -f "$PUCKMAN_PKG/$download_file" ];then
        download=-1
        echo "File $download_file already exists. Checking similarities"
        local url_size=$(url_size "$download_link")
        local url_timestamp=$(url_timestamp "$download_link")
        local local_size=$(stat --format %s "$PUCKMAN_PKG/$download_file")
        local local_timestamp=$(stat --format %Y "$PUCKMAN_PKG/$download_file")

        echo 
        echo "local_timestamp: $local_timestamp"
        echo "url_timestamp:   $url_timestamp"
        echo "local_size:      $local_size"
        echo "url_size:        $url_size"
        echo

        if [ $local_size -ne $url_size ] || [ $local_timestamp -ne $url_timestamp ];then 
            echo "Size or date don't match. Download the file"
            download=0
        fi
    fi
    if [ $download -eq 0 ];then 
        echo Downloading...
        [ -n "$regex" ] && find "$PUCKMAN_PKG" -type f -iregex '.*'"$regex" -delete
        cd "$PUCKMAN_PKG" && $WGET "$download_link" && cd -
    fi

    # - actually install (basename extension, tar, deb etc)
    
    IFS="#" read -r count original_name final_name < <(archive_count "$download_file")
    case $download_file in
        *.deb)
            echo "It is a debian package. Install with dpkg:"
            local package_name=$(dpkg-deb -I  $PUCKMAN_PKG/$download_file  | grep -Po '(?<=Package: ).*')
            local package_version=$(dpkg-deb -I  $PUCKMAN_PKG/$download_file  | grep -Po '(?<=Version: ).*')
            if dpkg-query -s "$package_name" &>/dev/null ;then
                #already installed, check version
                local installed_package_version
                installed_package_version=$(apt show "$package_name" 2>/dev/null | grep -Po '(?<=Version: ).*' | head -n1)
                if [ "$package_version" = "$installed_package_version" ];then 
                    echo ""
                    echo "Version $package_version of package $package_name is already installed"
                    echo ""
                    echo "You can manually install the package with:"
                    echo "sudo dpkg -i $PUCKMAN_PKG/$download_file"
                    write_manifest_deb "$link" "$package_name" "$download_file"
                    return 0
                else
                    echo "Version $installed_package_version of package $package_name is already installed. Proceeding to install new version: $package_version"
                fi
            fi
            echo "INSTALLING DEB PACKAGE: sudo dpkg -i $PUCKMAN_PKG/$download_file"
            if sudo dpkg -i "$PUCKMAN_PKG/$download_file"; then
                sudo apt install -f
                write_manifest_deb "$link" "$package_name" "$download_file"
            else
                return 1
            fi
            ;;
        *.zip)
            if [ $count -eq 1 ];then
                install_single_binary_archive "$link" "$download_file" "$original_name" "$final_name" zip || return 1
            else
                echo There seems to be more than a single binary. 
                echo You are on your own. Package has already been downloaded to:
                echo $PUCKMAN_PKG/$download_file
            fi
            ;;
        *.tar.gz|*.tgz|*.tbz|*.tar.xz|*.txz|*.tar.bz2|*.tbz2)
            if [ $count -eq 1 ];then
                install_single_binary_archive "$link" "$download_file" "$original_name" "$final_name" tar || return 1
            else
                echo There seems to be more than a single binary. 
                echo You are on your own. Package has already been downloaded to:
                echo $PUCKMAN_PKG/$download_file
            fi
            ;;
        *.bz2)
            echo it is a non-tar bz2. Hopefully a binary alone
            bunzip2 -f "$PUCKMAN_PKG/$download_file" || return 1
            chmod +x "$PUCKMAN_PKG/$original_name"
            local final_name_bz
            if [[ "$original_name" =~ ^([a-z]+) ]]; then
                final_name_bz="/usr/local/bin/${BASH_REMATCH[1]}"
            else
                final_name_bz="/usr/local/bin/${original_name##*/}"
            fi
            echo "Copying to $final_name_bz"
            if cp "$PUCKMAN_PKG/$original_name" "$final_name_bz"; then
                write_manifest_file "$link" "$final_name_bz" "$download_file"
            else
                return 1
            fi
            ;;
        *)
            if file "$PUCKMAN_PKG/$download_file" | grep 'ELF\|shell script\|script executable' &> /dev/null ;then
                echo it is a single binary or script
                echo installing to /usr/local/bin/$(basename "$link")
                local bin_path=/usr/local/bin/$(basename "$link")
                if cp "$PUCKMAN_PKG/$download_file" "$bin_path" && chmod +x "$bin_path"; then
                    write_manifest_file "$link" "$bin_path" "$download_file"
                fi
            fi
            ;;
    esac

    return 0
    # fi
    # echo "I don't know how to $action $package."
    # return 1
}

file_age(){
    if [ -e "$1" ] && [ -f "$1" ] && [ -s "$1" ];then
        echo -n "$((($(date +%s) - $(date +%s -r "$1")) / 86400)) days"
    else
        echo -n "0 days"
    fi
}

# Build or display cached project descriptions with stars from GitHub metadata.
# Root mode refreshes cache; non-root mode reads existing description cache.
list(){
    local n=15
    local n_days_ago=/tmp/${n}_days_ago
    touch -d "$n days ago" "$n_days_ago"
    if user_is_root ;then
        if [ ! -f "$PUCKMAN_DESCRIPTIONS" ] || [ "$PUCKMAN_DESCRIPTIONS" -ot "$n_days_ago" ] || [ "$(grep -c '^' "$PUCKMAN_DESCRIPTIONS")" -ne "$(grep -c '/' "$PUCKMAN_LIST")" ];then
            local tmp_file
            tmp_file=$(mktemp)
            while read -r project;do
                #TODO: fix me
                { echo -en "$project\t"; $WGET  --header "Accept: application/vnd.github+json" "${GITHUB_TOKEN[@]}" "https://api.github.com/repos/$project" -qO - | jq .stargazers_count,.description | awk -v d="\t" '{s=(NR==1?s:s d)$0}END{print s}' ;} >> "$tmp_file"
            done < <(cut -d '#' -f 1 "$PUCKMAN_LIST"| grep '/')
            mv "$tmp_file" "$PUCKMAN_DESCRIPTIONS"
        fi
        # Make sure others have read access
        chmod uga+r "$PUCKMAN_DESCRIPTIONS"
    else
        if [ -e "$PUCKMAN_DESCRIPTIONS" ] && [ -f "$PUCKMAN_DESCRIPTIONS" ] && [ -s "$PUCKMAN_DESCRIPTIONS" ] ;then
            if [ "$PUCKMAN_DESCRIPTIONS" -ot "$n_days_ago" ];then
                echo -en "Descriptions list in $PUCKMAN_DESCRIPTIONS is "; file_age "$PUCKMAN_DESCRIPTIONS"; echo " old"
                echo "Consider running 'puckman ls' with root to update it"
            fi
        else
            echo "Description file $PUCKMAN_DESCRIPTIONS does not exist. Run with root to create one."
            return 1
        fi
    fi
    echo
    echo -e "PROJECT\tSTARS\tDESCRIPTION\n$(sort "$PUCKMAN_DESCRIPTIONS")"| column -ts $'\t'
    return 0
}
showconfig(){
    (set -o posix; set  | grep '^PUCKMAN_')
}

readconfig(){
    # -e file exists
    # -f file is a regular file (not a directory or device file)
    # -s file is not zero size
    { [ -e "$PUCKMAN_CONFIG" ] && [ -f "$PUCKMAN_CONFIG" ] && [ -s "$PUCKMAN_CONFIG" ] ;} || return 1
    local tmpfile
    tmpfile=$(mktemp "/tmp/${__base}.XXXXXX")
    grep -Ei '^[[:space:]]*[a-z_.-]+=[^[;,`()%$!#]+[[:space:]]*$' "$PUCKMAN_CONFIG" > "$tmpfile"
    source "$tmpfile"
    rm -f "$tmpfile"
}

apt_install_requirements_cmd() {
    # Keep this list aligned with check_environment() required tool checks.
    local required="file jq wget python3 sudo coreutils bzip2 unzip bsdextrautils"
    local recommended="python3-pylev"
    printf 'apt update && apt install -y %s %s\n' "$required" "$recommended"
}

user_is_root(){
    if [ "$EUID" -ne 0 ];then
        return 1
    fi
    return 0
}

install_requirements(){
    local cmd
    cmd=$(apt_install_requirements_cmd)
    echo "This will install required and recommended packages:"
    echo "sudo $cmd"
    while true; do
        read -rp "Proceed? [Y/n]: " yn < "$TTY"
        case $yn in
            ""|[Yy] )
                if ! type apt &>/dev/null; then
                    echo "apt is not available on this system."
                    return 1
                fi
                apt update && apt install -y file jq wget python3 sudo coreutils bzip2 unzip bsdextrautils python3-pylev
                return $?
                ;;
            [Nn] )
                echo "Cancelled."
                return 1
                ;;
            * ) echo "Please answer with y or n.";;
        esac
    done
}

# Validate runtime dependencies and required storage paths before actions run.
# Prompts to create missing directories for configured PUCKMAN paths.
check_environment (){
    local var_path
    local var_value
    TTY=$(tty)
    local dependencies_exist=true
    local dep
    for dep in file jq wget python3 sudo column unzip bunzip2; do
        if ! type "$dep" &>/dev/null; then
            case "$dep" in
                bunzip2)
                    echo "Please install bzip2 (provides bunzip2): e.g. apt install bzip2"
                    ;;
                column)
                    echo "Please install column: e.g. apt install bsdextrautils or bsdmainutils"
                    ;;
                wget)
                    echo "Please install wget: e.g. apt install wget"
                    ;;
                *)
                    echo "Please install $dep: e.g. apt install $dep"
                    ;;
            esac
            dependencies_exist=false
        fi
    done
    local apt_cmd
    apt_cmd=$(apt_install_requirements_cmd)
    echo "Install all requirements with:"
    echo "sudo $apt_cmd"
    if ! python3 -c "import pylev" &>/dev/null; then
        echo "Recommended: install python3-pylev for faster artifact matching."
    fi
    if ! { date -d @0 +%s &>/dev/null && stat --format %s "${BASH_SOURCE[0]}" &>/dev/null; }; then
        echo "Please install GNU coreutils: e.g. apt install coreutils"
        dependencies_exist=false
    fi
    if [ "$dependencies_exist" = false ];then
        echo "Install dependencies before continuing"
        exit 1
    fi

    mkdir -p "$PUCKMAN_STATE/installed"

    while  read -r line;do
        var_value="${!line}"
        var_path="${var_value%/*.*}"
        #echo --------------------
        #echo $line=$var_value
        #echo $var_path
        
        if [ ! -d "$var_path" ];then
            echo Location does not exist:
            echo ${line}=$var_value
            echo PATH: $var_path
            echo
            while true; do
                read -rp "Should I try to create $var_path? [Y/n]: " yn < "$TTY"
                case $yn in
                    ""|[Yy] )
                        mkdir -p "$var_path"
                        break
                        ;;
                    [Nn] )
                        echo "You can use a config file to change the path of $line as needed. "
                        exit 1
                        ;;
                    * ) echo "Please answer with y or n.";;
                esac
            done
        fi
    done < <(set -o posix; set  | grep '^PUCKMAN_' |cut -d '=' -f 1 )
}

is_git_repo(){
    git -C "$1" rev-parse 2>/dev/null; 
    return $? # 0 = git repository
}

# Update puckman itself from git or from remote script URL with checksum check.
# Chooses git pull for repo installs, otherwise downloads and replaces script file.
update(){
    if is_git_repo "$__dir";then
        # repo must be 'pristine' for this to work
        # otherwise you're on your own
        echo "updating local repository under $__dir"
        git -C "$__dir" pull || echo -e "Tried command:\n\ngit -C \"$__dir\" pull\n"
    else
        local url_size=$(url_size "$UPDATE_LINK")
        local url_timestamp=$(url_timestamp "$UPDATE_LINK")
        local local_size=$(stat --format %s "$__file")
        local local_timestamp=$(stat --format %Y "$__file")

        echo 
        echo "local_timestamp: $local_timestamp $(date -d @${local_timestamp})"
        echo "url_timestamp:   $url_timestamp $(date -d "@${url_timestamp}" 2>/dev/null || echo "?")"
        echo "local_size:      $local_size Bytes"
        echo "url_size:        $url_size Bytes"
        echo
        local temp=$(mktemp)
        $WGET "$UPDATE_LINK?$(date +%s)" -O "$temp"

        # Does the current file have the same md5 than the downloaded one?
        if echo "$(md5sum "$temp" | awk '{print $1}') $__file" | md5sum --check --status; then
            echo No update needed.
        else 
            echo "Checksums don't match. Download the file"
            echo "Downloading from link: $UPDATE_LINK to location: $__file"
            mv "$temp" "$__file"
            #ensure execution permissions
            chmod 755 "$__file"
        fi
    fi
}



